{
  "name": "chushou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run data:generate && npm run dev --workspace @chushou/web",
    "build": "npm run data:generate && npm run build --workspace @chushou/web",
    "clean": "npm run clean --if-present --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:validate": "tsx tools/ingest/src/cli.ts validate",
    "data:generate": "tsx tools/ingest/src/cli.ts generate",
    "data:report": "tsx tools/ingest/src/cli.ts report",
    "schema:json": "tsx tools/ingest/src/cli.ts schema",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run data:validate && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
